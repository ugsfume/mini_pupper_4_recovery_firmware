# MP4 ESP32 CORE: ESP32-S3-WROOM-1-N16R8
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# The robot's partition table (partitions.csv): NVS at 0x9000, shared with the
# main firmware's calibration
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console on UART0 (USB, CH340K) at 115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# No current guard in get-up mode (SET_ALL flag GETUP); the walking current
# guard and the temperature guard stay on
CONFIG_APP_RL_GUARD_GETUP_CUR_MA=0
# Walking current guard, above the 1000 mA default, so hand shoves do not trip it
CONFIG_APP_RL_GUARD_CUR_MA=1500
